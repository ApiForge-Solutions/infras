# Local .terraform directories

.terraform/

# Ignore vault data

.vault_pass

# .tfstate files

#*.tfstate
#*.tfstate.*

# Crash log files

crash.log
crash.*.log

# Exclude all .tfvars files

*.tfvars
*.tfvars.json

# Allow the Terraform variables file for FastAPI

!fastapi/infra/terraform.tfvars

# Ignore override files

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files

.terraform.tfstate.lock.info

# Include override files you wish to add

# !example_override.tf

# Ignore plan files

# example: *tfplan*

# Ignore CLI configuration files

.terraformrc
terraform.rc

# Optional: Terraform graph output

# *.dot

# Optional: plan output before destroying resources

# planout

run.log

