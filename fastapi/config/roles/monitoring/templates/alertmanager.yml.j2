route:
  receiver: team
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: team
    slack_configs:
      - api_url: "{{ ALERT_WEBHOOK_URL }}"
        channel: "#alerts"
        send_resolved: true
        title: "{{ '{{' }} .CommonLabels.alertname {{ '}}' }}"
        text: "{{ '{{' }} range .Alerts {{ '}}' }}{{ '{{' }} .Annotations.summary {{ '}}' }}\n{{ '{{' }} end {{ '}}' }}"