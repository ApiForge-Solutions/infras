# roles/monitoring/templates/prometheus.yml.j2
global:
  scrape_interval: 30s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
{% for g in ['k8s_masters', 'k8s_workers', 'minio', 'monitoring', 'jenkins'] %}
{% if groups.get(g) %}
      - targets:
{% for h in groups[g] %}
          - {{ hostvars[h].ansible_host }}:9100
{% endfor %}
        labels:
          role: {{ g }}
{% endif %}
{% endfor %}

  - job_name: minio
    metrics_path: /minio/v2/metrics/cluster
    static_configs:
      - targets: ['{{ hostvars["minio_server"].ansible_host }}:9000']

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']