apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ env.name }}
  namespace: {{ ARGOCD_NAMESPACE }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default

  source:
    repoURL: {{ ARGOCD_REPO_URL }}
    targetRevision: {{ ARGOCD_REPO_REVISION }}
    path: {{ ARGOCD_CHART_PATH }}
    helm:
      valueFiles:
        - {{ env.values_file }}

  destination:
    server: 'https://kubernetes.default.svc'
    namespace: {{ env.namespace }}

  syncPolicy:
{% if env.auto_sync %}
    automated:
      # prune supprime du cluster ce qui disparait du depot.
      # selfHeal annule toute modification faite a la main par kubectl.
      prune: true
      selfHeal: true
{% else %}
{% endif %}
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 3
      backoff:
        duration: 10s
        factor: 2
