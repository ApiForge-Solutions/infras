###############################################################################
# Traefik Helm Values - Gateway API + Ingress + IngressRoute, TLS via cert-manager
# NOTE: no certResolvers here — TLS certificates are managed by cert-manager,
# not by Traefik itself.
###############################################################################

image:
  tag: "{{ TRAEFIK_VERSION }}"

deployment:
  replicas: {{ TRAEFIK_REPLICAS }}

# Enable all three routing providers: IngressRoute (our own routes),
# Ingress (for upstream charts like ArgoCD that only support plain Ingress),
# and Gateway API (forward-compatible, some charts are moving to it).
providers:
  kubernetesGateway:
    enabled: true
  kubernetesCRD:
    enabled: true
  kubernetesIngress:
    enabled: true

ports:
  web:
    port: 8000
    exposedPort: 80
    protocol: TCP
    # HTTP -> HTTPS redirect priority is lowered so it does NOT intercept
    # the ACME HTTP-01 challenge path (/.well-known/acme-challenge/...).
    # cert-manager's solver route has a higher priority (Host+PathPrefix match)
    # and will win instead of being redirected to HTTPS, where it would fail.
    redirectTo:
      port: websecure
      priority: 10
  websecure:
    port: 8443
    exposedPort: 443
    protocol: TCP
    tls:
      enabled: true
      # No certResolver: cert-manager provisions certs via Certificate/ClusterIssuer

# LoadBalancer type: MetalLB assigns an IP from its pool and announces it
# on the LAN. This becomes the cluster's single entry point.
service:
  type: LoadBalancer
  annotations:
    metallb.io/loadBalancerIPs: "{{ TRAEFIK_LB_IP }}"
  spec:
    externalTrafficPolicy: Local

api:
  dashboard: true
  insecure: false

extraObjects:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: dashboard-auth-secret
    type: kubernetes.io/basic-auth
    stringData:
      username: "{{ dashboard_user }}"
      password: "{{ dashboard_password }}"
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: dashboard-auth
    spec:
      basicAuth:
        secret: dashboard-auth-secret

ingressRoute:
  dashboard:
    enabled: true
    matchRule: Host(`traefik.{{ app_domain }}`)
    entryPoints:
      - websecure
    middlewares:
      - name: dashboard-auth
    tls:
      secretName: dashboard-tls

log:
  level: "{{ TRAEFIK_LOG_LEVEL | default('INFO') }}"

accessLog:
  enabled: true

metrics:
  prometheus:
    enabled: true

resources:
  requests:
    cpu: "{{ TRAEFIK_CPU_REQUEST | default('100m') }}"
    memory: "{{ TRAEFIK_MEMORY_REQUEST | default('128Mi') }}"
  limits:
    cpu: "{{ TRAEFIK_CPU_LIMIT | default('500m') }}"
    memory: "{{ TRAEFIK_MEMORY_LIMIT | default('512Mi') }}"

podDisruptionBudget:
  enabled: true
  minAvailable: 1
