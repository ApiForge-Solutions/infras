diff --git a/fastapi/config/group_vars/all/main.yml b/fastapi/config/group_vars/all/main.yml
index 42e6a64..56288a5 100644
--- a/fastapi/config/group_vars/all/main.yml
+++ b/fastapi/config/group_vars/all/main.yml
@@ -47,6 +47,7 @@ ARGOCD_NAMESPACE: "argocd"
 MINIO_S3_URL: "http://{{ hostvars['minio_server'].ansible_host }}:9000"
 BUCKET_NAME: velero-backup
 DB_BACKUP_BUCKET: db-backup        # sauvegardes pg_dump (CronJob db-backup du chart)
+DB_BACKUP_RETENTION_DAYS: 7          # rétention appliquée par MinIO (règle de cycle de vie)
 # DB_BACKUP_S3_USER et DB_BACKUP_S3_PASSWORD : à ajouter dans group_vars/all/vault.yml
 
 ansible_python_interpreter: /usr/bin/python3
diff --git a/fastapi/config/roles/minio/tasks/main.yml b/fastapi/config/roles/minio/tasks/main.yml
index d47f7a8..010e34f 100644
--- a/fastapi/config/roles/minio/tasks/main.yml
+++ b/fastapi/config/roles/minio/tasks/main.yml
@@ -220,6 +220,10 @@
     mc admin user add local "{{ DB_BACKUP_S3_USER }}" "{{ DB_BACKUP_S3_PASSWORD }}"
     mc admin policy create local dbbackup /etc/minio-dbbackup-policy.json || mc admin policy add local dbbackup /etc/minio-dbbackup-policy.json
     mc admin policy attach local dbbackup --user "{{ DB_BACKUP_S3_USER }}" || mc admin policy set local dbbackup user="{{ DB_BACKUP_S3_USER }}"
+    # Rétention : les sauvegardes de plus de N jours sont supprimées par MinIO (une seule règle, idempotente)
+    if ! mc ilm rule ls local/{{ DB_BACKUP_BUCKET }} 2>/dev/null | grep -q "{{ DB_BACKUP_RETENTION_DAYS }}"; then
+      mc ilm rule add local/{{ DB_BACKUP_BUCKET }} --expire-days {{ DB_BACKUP_RETENTION_DAYS }}
+    fi
   args:
     executable: /bin/bash
   environment:
